# BrooksHouse cloud foundation - names and safe examples only.
# Never place real credentials in source control.

BROOKSHOUSE_APP_ENV=staging
BROOKSHOUSE_RELEASE=staging-001
BROOKSHOUSE_PROCESS_ROLE=web
BROOKSHOUSE_BACKGROUND_JOBS_ENABLED=false
BROOKSHOUSE_POSTGRES_MIGRATION_READY=false

# SQLite remains active during the compatibility phase.
DATABASE_URL=sqlite:///app/data/brookshouse_store.db
BROOKSHOUSE_STORAGE_ROOT=app/data

BROOKSHOUSE_ACCESS_SECRET=
KIDS_HELPER_COOKIE_SECRET=
KIDS_HELPER_PIN_HASH=
SHOPIFY_API_VERSION=
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
SHOPIFY_STORE=
AMAZON_LWA_CLIENT_ID=
AMAZON_LWA_CLIENT_SECRET=
AMAZON_MARKETPLACE_ID=
AMAZON_REFRESH_TOKEN=
WALMART_API_BASE_URL=
WALMART_CLIENT_ID=
WALMART_CLIENT_SECRET=
WALMART_MARKETPLACE=
BRAVE_SEARCH_API_KEY=
